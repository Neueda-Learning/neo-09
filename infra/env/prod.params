# neo-09's OWN service (module 01: Customer Support), on prod. Identical to
# dev.params — a module carries no environment-specific values (the orchestrator URL is built
# from the Cloud Map namespace in the template). The pipeline adds EnvironmentName + the
# PINNED @sha256 images + DbEndpoint + AlbDnsName.
ServiceName=neo-09
Role=module
PathPrefix=/neo-09
ListenerRulePriority=90
DbName=neo_09
ServiceId=neo09
DisplayName=Customer Support
Domain=support
Team=Team 09
MockedDependencies=
